{
  "name": "multiblast",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "start:web": "npm run start --workspace=@multiblast/web",
    "start:worker": "npm run start --workspace=@multiblast/worker",
    "db:migrate": "node packages/shared/src/db/migrate.js"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.0"
}
